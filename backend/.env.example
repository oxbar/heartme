POSTGRES_DB=himeros
POSTGRES_USER=himeros
POSTGRES_PASSWORD=himeros_dev
JWT_SECRET=change-me-change-me-change-me-change-me
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200
MEDIA_DIR=./data/media

# Discovery Engine V2
HIMEROS_DISCOVERY_POOL_SIZE=1000
HIMEROS_DISCOVERY_POOL_MULTIPLIER=20
HIMEROS_DISCOVERY_NON_STRICT_RADIUS_KM=250
HIMEROS_DISCOVERY_MAX_RETRIEVAL_RADIUS_KM=1000
HIMEROS_DISCOVERY_CACHE_TTL=45s
HIMEROS_DISCOVERY_VIEW_COOLDOWN=24h
HIMEROS_DISCOVERY_PASS_COOLDOWN=14d
HIMEROS_DISCOVERY_LIKE_COOLDOWN=30d
HIMEROS_DISCOVERY_SUPER_LIKE_COOLDOWN=30d
HIMEROS_DISCOVERY_UNMATCH_COOLDOWN=90d
HIMEROS_DISCOVERY_COLD_START_INTERACTIONS=20
HIMEROS_DISCOVERY_IMPLICIT_HISTORY_LIMIT=200
HIMEROS_DISCOVERY_NEW_PROFILE_DAYS=7
HIMEROS_DISCOVERY_NEW_PROFILE_SHARE=0.10
HIMEROS_DISCOVERY_EXPLORATION_SHARE=0.05
HIMEROS_DISCOVERY_DIVERSIFICATION_PENALTY=0.12
# Local/dev diagnostics only; keep false in production.
HIMEROS_DISCOVERY_EXPLAIN_ENABLED=true
